  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Solid ink action, once per context (New quote, Reprint).",
      "html": "<button class=\"ds-btn ds-btn-primary\">New quote</button>",
      "css": ".ds-btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;height:36px;padding:0 16px;font:600 14px/1 Archivo,ui-sans-serif,system-ui,sans-serif;border-radius:2px;border:1px solid transparent;cursor:pointer;transition:background-color 150ms,color 150ms}.ds-btn-primary{background:hsl(var(--primary, 210 13% 13%));color:hsl(var(--primary-foreground, 45 43% 98%))}.ds-btn-primary:hover{background:hsl(var(--primary, 210 13% 13%) / 0.85)}.ds-btn-primary:active{background:hsl(var(--primary, 210 13% 13%) / 0.75)}.ds-btn:focus-visible{outline:none;box-shadow:0 0 0 2px hsl(var(--background, 45 12% 90%)),0 0 0 4px hsl(var(--ring, 205 34% 25%))}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Default button: 1px ink outline; the rack-card next action.",
      "html": "<button class=\"ds-btn2\">Start print</button>",
      "css": ".ds-btn2{display:inline-flex;align-items:center;justify-content:center;height:36px;padding:0 16px;font:600 14px/1 Archivo,ui-sans-serif,system-ui,sans-serif;border-radius:2px;border:1px solid hsl(var(--foreground, 210 13% 13%));background:transparent;color:hsl(var(--foreground, 210 13% 13%));cursor:pointer;transition:background-color 150ms}.ds-btn2:hover{background:hsl(var(--foreground, 210 13% 13%) / 0.06)}.ds-btn2:active{background:hsl(var(--foreground, 210 13% 13%) / 0.1)}.ds-btn2:focus-visible{outline:none;box-shadow:0 0 0 2px hsl(var(--background, 45 12% 90%)),0 0 0 4px hsl(var(--ring, 205 34% 25%))}"
    },
    {
      "name": "Danger Button",
      "kind": "button",
      "refersTo": "button-danger",
      "description": "Red outline that fills solid on hover; destructive actions.",
      "html": "<button class=\"ds-btn-danger\">Cancel order</button>",
      "css": ".ds-btn-danger{display:inline-flex;align-items:center;height:36px;padding:0 16px;font:600 14px/1 Archivo,ui-sans-serif,system-ui,sans-serif;border-radius:2px;border:1px solid hsl(var(--destructive, 4 64% 47%));background:transparent;color:hsl(var(--destructive, 4 64% 47%));cursor:pointer;transition:background-color 150ms,color 150ms}.ds-btn-danger:hover{background:hsl(var(--destructive, 4 64% 47%));color:hsl(var(--destructive-foreground, 45 43% 98%))}.ds-btn-danger:focus-visible{outline:none;box-shadow:0 0 0 2px hsl(var(--background, 45 12% 90%)),0 0 0 4px hsl(var(--ring, 205 34% 25%))}"
    },
    {
      "name": "Input Field",
      "kind": "input",
      "refersTo": "input",
      "description": "Label, paper control with control-edge border, hint below.",
      "html": "<div class=\"ds-field\"><label class=\"ds-label\" for=\"ds-q\">Customer name</label><input id=\"ds-q\" class=\"ds-input\" placeholder=\"Mariam Hassan\"><p class=\"ds-hint\">Shown on the quote.</p></div>",
      "css": ".ds-field{display:grid;gap:6px;max-width:320px;font-family:Archivo,ui-sans-serif,system-ui,sans-serif}.ds-label{font-size:13px;font-weight:600;color:hsl(var(--foreground, 210 13% 13%))}.ds-input{height:36px;padding:0 12px;font-size:14px;border-radius:2px;border:1px solid hsl(var(--input, 43 5% 53%));background:hsl(var(--card, 45 43% 98%));color:hsl(var(--foreground, 210 13% 13%));transition:border-color 150ms}.ds-input::placeholder{color:hsl(var(--muted-foreground, 210 8% 31%))}.ds-input:hover{border-color:hsl(var(--foreground, 210 13% 13%) / 0.6)}.ds-input:focus-visible{outline:none;border-color:hsl(var(--foreground, 210 13% 13%));box-shadow:0 0 0 2px hsl(var(--ring, 205 34% 25%))}.ds-input[aria-invalid=true]{border-color:hsl(var(--destructive, 4 64% 47%));background:hsl(var(--destructive-soft, 9 60% 91%) / 0.4)}.ds-hint{margin:0;font-size:12px;color:hsl(var(--muted-foreground, 210 8% 31%))}"
    },
    {
      "name": "Rail Navigation",
      "kind": "nav",
      "refersTo": "nav-item-active",
      "description": "Enamel rail; the active item is a paper card with a yellow head.",
      "html": "<nav class=\"ds-rail\"><p class=\"ds-rail-sec\">Production</p><a class=\"ds-rail-item ds-active\" href=\"#\">Queue<span class=\"ds-count ds-alert\">1</span></a><a class=\"ds-rail-item\" href=\"#\">Printers</a><a class=\"ds-rail-item\" href=\"#\">Materials<span class=\"ds-count\">3</span></a></nav>",
      "css": ".ds-rail{width:224px;padding:12px;background:hsl(var(--sidebar, 205 34% 25%));font-family:Archivo,ui-sans-serif,system-ui,sans-serif;display:grid;gap:1px}.ds-rail-sec{margin:0;padding:0 10px 4px;font-size:12px;font-weight:600;color:hsl(var(--sidebar-muted, 205 20% 66%))}.ds-rail-item{display:flex;align-items:center;gap:10px;height:36px;padding:0 10px;border-radius:2px;font-size:14px;font-weight:500;color:hsl(var(--sidebar-foreground, 203 26% 89%));text-decoration:none;transition:background-color 150ms}.ds-rail-item:hover{background:hsl(var(--sidebar-raised, 203 31% 31%))}.ds-rail-item.ds-active{background:hsl(var(--sidebar-active, 45 43% 98%));color:hsl(var(--sidebar-active-foreground, 210 13% 13%));font-weight:600;box-shadow:inset 0 3px 0 hsl(var(--stock-quoted, 48 85% 62%))}.ds-rail-item:focus-visible{outline:none;box-shadow:0 0 0 2px hsl(var(--sidebar, 205 34% 25%)),0 0 0 4px hsl(var(--ring, 205 34% 25%))}.ds-count{margin-left:auto;padding:0 6px;border-radius:2px;font-size:12px;font-variant-numeric:tabular-nums;color:hsl(var(--sidebar-muted, 205 20% 66%))}.ds-alert{background:hsl(var(--stock-failed, 4 64% 47%));color:#fff;font-weight:700}"
    },
    {
      "name": "Stock Tags",
      "kind": "chip",
      "refersTo": "stock-tag",
      "description": "Status as card stock; one colour per status, everywhere.",
      "html": "<div class=\"ds-tags\"><span class=\"ds-tag ds-draft\">Draft</span><span class=\"ds-tag ds-quoted\">Quoted</span><span class=\"ds-tag ds-approved\">Approved</span><span class=\"ds-tag ds-printing\">Printing</span><span class=\"ds-tag ds-qc\">Quality check</span><span class=\"ds-tag ds-failed\">Failed</span><span class=\"ds-tag ds-void\">Cancelled</span><span class=\"ds-tag ds-done\">Completed</span></div>",
      "css": ".ds-tags{display:flex;flex-wrap:wrap;gap:6px}.ds-tag{display:inline-flex;align-items:center;height:22px;padding:0 8px;border-radius:2px;border:1px solid hsl(var(--stock-edge, 41 6% 64%));font:600 12px/1 Archivo,ui-sans-serif,system-ui,sans-serif;color:hsl(var(--stock-ink, 210 13% 13%));white-space:nowrap}.ds-draft{background:hsl(var(--stock-draft, 45 43% 98%))}.ds-quoted{background:hsl(var(--stock-quoted, 48 85% 62%))}.ds-approved{background:hsl(var(--stock-approved, 135 34% 67%))}.ds-printing{background:hsl(var(--stock-printing, 211 56% 71%))}.ds-qc{background:hsl(var(--stock-qc, 10 72% 74%))}.ds-void{background:hsl(var(--stock-void, 42 9% 78%))}.ds-void{text-decoration:line-through}.ds-failed{background:hsl(var(--stock-failed, 4 64% 47%));color:#fff}.ds-done{background:hsl(var(--stock-done, 205 13% 41%));color:hsl(var(--stock-done-ink, 45 43% 98%))}"
    },
    {
      "name": "T-Card",
      "kind": "custom",
      "refersTo": "tcard-head",
      "description": "Signature: stock head over an inset paper body, with the next action on the card.",
      "html": "<div class=\"ds-tcard\"><div class=\"ds-tc-head\"><span>PRINTING</span><a href=\"#\">ORD-1040</a></div><div class=\"ds-tc-body\"><p class=\"ds-tc-name\">Mariam Hassan</p><p class=\"ds-tc-meta\"><span>EGP 1,600.00</span><span>3h ago</span></p><button class=\"ds-tc-btn\">Mark printed</button></div></div>",
      "css": ".ds-tcard{width:150px;font-family:Archivo,ui-sans-serif,system-ui,sans-serif;font-variant-numeric:tabular-nums}.ds-tc-head{position:relative;z-index:1;display:flex;justify-content:space-between;gap:8px;align-items:center;height:22px;padding:0 8px;border:1px solid hsl(var(--stock-edge, 41 6% 64%));background:hsl(var(--stock-printing, 211 56% 71%));color:hsl(var(--stock-ink, 210 13% 13%));font-size:11px;font-weight:700;letter-spacing:0.02em}.ds-tc-head span{flex-shrink:0;white-space:nowrap}.ds-tc-head a{min-width:0;color:inherit;font-weight:600;text-underline-offset:2px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.ds-tc-head a:hover{text-decoration:none}.ds-tc-body{margin:-1px 6px 0;padding:6px 8px 8px;border:1px solid hsl(var(--stock-edge, 41 6% 64%));border-top:0;background:hsl(var(--card, 45 43% 98%));color:hsl(var(--card-foreground, 210 13% 13%))}.ds-tc-name{margin:0;font-size:13px;font-weight:600}.ds-tc-meta{margin:2px 0 0;display:flex;justify-content:space-between;font-size:12px;color:hsl(var(--muted-foreground, 210 8% 31%))}.ds-tc-btn{margin-top:8px;width:100%;height:28px;border-radius:2px;border:1px solid hsl(var(--foreground, 210 13% 13%));background:transparent;color:hsl(var(--foreground, 210 13% 13%));font:600 13px/1 Archivo,ui-sans-serif,system-ui,sans-serif;cursor:pointer;transition:background-color 150ms}.ds-tc-btn:hover{background:hsl(var(--foreground, 210 13% 13%) / 0.06)}.ds-tc-btn:focus-visible{outline:none;box-shadow:0 0 0 2px hsl(var(--background, 45 12% 90%)),0 0 0 4px hsl(var(--ring, 205 34% 25%))}"
    },
    {
      "name": "Status Lamp",
      "kind": "custom",
      "refersTo": "lamp",
      "description": "Printer state: a lit dot plus its word, never colour alone.",
      "html": "<div class=\"ds-lamps\"><span class=\"ds-lamp\"><i class=\"ds-run\"></i>Printing</span><span class=\"ds-lamp\"><i class=\"ds-ready\"></i>Ready</span><span class=\"ds-lamp ds-fault\"><i class=\"ds-bad\"></i>Failed print</span></div>",
      "css": ".ds-lamps{display:flex;gap:16px}.ds-lamp{display:inline-flex;align-items:center;gap:6px;font:600 12px/1 Archivo,ui-sans-serif,system-ui,sans-serif;color:hsl(var(--foreground, 210 13% 13%))}.ds-lamp i{width:8px;height:8px;border-radius:9999px;box-shadow:0 0 0 1px hsl(var(--stock-edge, 41 6% 64%))}.ds-run{background:hsl(var(--stock-printing, 211 56% 71%))}.ds-ready{background:hsl(var(--stock-approved, 135 34% 67%))}.ds-bad{background:hsl(var(--stock-failed, 4 64% 47%))}.ds-fault{color:hsl(var(--destructive, 4 64% 47%))}"
    },
    {
      "name": "KPI Strip",
      "kind": "card",
      "refersTo": "stat-cell",
      "description": "Figures ruled under a 2px ink line, hairline gaps between cells.",
      "html": "<div class=\"ds-strip\"><div class=\"ds-cell\"><p class=\"ds-l\">Open orders</p><p class=\"ds-v\">7</p><p class=\"ds-h\">2 printing now</p></div><div class=\"ds-cell\"><p class=\"ds-l\">Printers ready</p><p class=\"ds-v\">4 / 5</p><p class=\"ds-h\">Active in your fleet</p></div></div>",
      "css": ".ds-strip{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1px;background:hsl(var(--border, 41 11% 76%));border-top:2px solid hsl(var(--rule, 210 13% 13%));border-bottom:1px solid hsl(var(--border, 41 11% 76%));font-family:Archivo,ui-sans-serif,system-ui,sans-serif;font-variant-numeric:tabular-nums}.ds-cell{background:hsl(var(--background, 45 12% 90%));padding:12px 16px}.ds-l,.ds-v,.ds-h{margin:0}.ds-l{font-size:13px;color:hsl(var(--muted-foreground, 210 8% 31%))}.ds-v{margin-top:2px;font-size:26px;font-weight:600;letter-spacing:-0.01em;line-height:1.25;color:hsl(var(--foreground, 210 13% 13%))}.ds-h{margin-top:2px;font-size:12px;color:hsl(var(--muted-foreground, 210 8% 31%))}"
    },
    {
      "name": "Failure Strip",
      "kind": "custom",
      "refersTo": "error-notice",
      "description": "Failed-card tab, message, and the fix inline.",
      "html": "<div class=\"ds-fail\" role=\"alert\"><span class=\"ds-fail-tab\">FAILED</span><p>ORD-1036 stopped printing.</p><button class=\"ds-fail-btn\">Reprint</button></div>",
      "css": ".ds-fail{display:flex;align-items:stretch;border:1px solid hsl(var(--destructive, 4 64% 47%));border-radius:2px;overflow:hidden;background:hsl(var(--destructive-soft, 9 60% 91%));font:14px/20px Archivo,ui-sans-serif,system-ui,sans-serif;color:hsl(var(--foreground, 210 13% 13%))}.ds-fail-tab{display:flex;align-items:center;padding:0 10px;background:hsl(var(--stock-failed, 4 64% 47%));color:#fff;font-size:11px;font-weight:700;letter-spacing:0.02em}.ds-fail p{flex:1;margin:0;padding:10px 12px}.ds-fail-btn{margin:6px 8px;height:32px;padding:0 12px;border:0;border-radius:2px;background:hsl(var(--primary, 210 13% 13%));color:hsl(var(--primary-foreground, 45 43% 98%));font:600 13px/1 Archivo,ui-sans-serif,system-ui,sans-serif;cursor:pointer;transition:background-color 150ms}.ds-fail-btn:hover{background:hsl(var(--primary, 210 13% 13%) / 0.85)}.ds-fail-btn:focus-visible{outline:none;box-shadow:0 0 0 2px hsl(var(--background, 45 12% 90%)),0 0 0 4px hsl(var(--ring, 205 34% 25%))}"
    }
  ],
  "narrative": {
    "northStar": "The T-Card Planning Board",
    "overview": "Every job is a coloured T-card hanging in a steel rack. The card's stock colour is its status, and it is the same colour everywhere: in the printer rack, in every status tag, in the swatch that leads a list row, in the brand mark. A printer is a slot column; a card's place in the column is its place in that printer's queue. The console sits on a warm grey board ground with an enamel steel-blue rail down the left. Paper-white card bodies are the only raised material.\n\nThe world is flat, square-cut and ruled. Structure comes from hairline rules and 2px ink rules under headers, not from boxes and shadows. Every number is set in tabular figures in Archivo. Density is high: it is a working board for staff at a desk and on a phone beside the printers, and it shows what every printer is doing and what needs a hand in one glance. Dark mode is the same rack at night. The ground and rail turn deep enamel blue, card bodies turn slate, the stock colours deepen but keep their identity, and ink becomes warm off-white. Nothing glows and nothing is pure black.\n\nRejected (confirmed by the build and PRODUCT.md): white-card SaaS consoles with indigo pills and stat tiles, glass, gradients, neon, soft drop shadows on resting surfaces.",
    "keyCharacteristics": [
      "Status is a card-stock colour, one vocabulary across every screen.",
      "Square-cut corners (2px) everywhere; only status lamps are round.",
      "Flat surfaces; depth only for overlays that leave the board.",
      "Hairline rules and 2px ink rules build structure instead of boxes.",
      "Archivo with tabular figures on the whole body.",
      "Light and dark are both first-class; dark is the same rack at night."
    ],
    "rules": [
      {
        "name": "The One Stock, One Meaning Rule",
        "body": "A stock colour always means the same status, on every surface. Statuses use `StockTag`, `StockSwatch` or `TCard`. Outline `Badge` is for flags and attributes (Business, Active, Default) and never for status.",
        "section": "colors"
      },
      {
        "name": "The Yellow Head Rule",
        "body": "Quoted Yellow is also the only \"you are here / today\" marker: the active nav item, today's bar, the brand mark. Don't introduce a second highlight hue.",
        "section": "colors"
      },
      {
        "name": "The Never Colour Alone Rule",
        "body": "A lamp always has its word next to it, and a stock tag always carries its label. Colour backs up the text; it never replaces it.",
        "section": "colors"
      },
      {
        "name": "The Tabular Board Rule",
        "body": "Figures are always tabular. Never switch a number back to proportional figures to make it look nicer.",
        "section": "typography"
      },
      {
        "name": "The Status Word Never Truncates Rule",
        "body": "In a T-card head the status word keeps its full width, and the aside (order number, time) truncates instead.",
        "section": "typography"
      },
      {
        "name": "The Only Overlays Lift Rule",
        "body": "Resting surfaces have no shadow (`shadow-card` is `none`). A shadow means the element is floating above the board.",
        "section": "elevation"
      },
      {
        "name": "The 2px Ceiling Rule",
        "body": "Nothing rounds past 2px except status lamps.",
        "section": "shapes"
      }
    ],
    "dos": [
      "**Do** show every status as its card stock (`StockTag`, `StockSwatch`, `TCard`), using the same stock on every surface.",
      "**Do** keep corners at 2px; only status lamps are round.",
      "**Do** build structure with 1px hairlines and the 2px ink rule under headers, not with nested boxes.",
      "**Do** keep resting surfaces flat; only overlays get the lift shadow, over the enamel scrim.",
      "**Do** pair every lamp and tag with its word.",
      "**Do** design dark mode as the same rack at night: enamel-blue ground, slate bodies, deepened stock, warm off-white ink.",
      "**Do** put the card's next action on the card itself and grow touch targets to 44px on phones."
    ],
    "donts": [
      "**Don't** use outline `Badge` or ad-hoc coloured pills for statuses.",
      "**Don't** add drop shadows to cards, KPI cells, tables or the rack.",
      "**Don't** add glass, gradients, neon or glow. In dark mode, don't use pure black.",
      "**Don't** add a second highlight hue; Quoted Yellow is the only \"current\" marker.",
      "**Don't** use proportional figures for prices, counts or times.",
      "**Don't** truncate the status word in a T-card head."
    ]
  }
}
