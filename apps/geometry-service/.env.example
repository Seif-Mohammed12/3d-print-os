# Service Configuration
SERVICE_NAME=geometry-analysis-service
ENVIRONMENT=development
DEBUG=false

# API Configuration
HOST=0.0.0.0
PORT=8000
API_PREFIX=/api/v1

# Database
DATABASE_URL=postgresql+asyncpg://printos:printos@localhost:5432/printos

# Storage (for fetching STL files)
STORAGE_BASE_URL=http://localhost:9000
STORAGE_BUCKET=model-files

# Analysis Limits
MAX_FILE_SIZE_BYTES=104857600
MAX_TRIANGLES=1000000

# Slicing (PrusaSlicer CLI). On Windows point this at prusa-slicer-console.exe, e.g.
# SLICER_EXECUTABLE=C:\Program Files\Prusa3D\PrusaSlicer\prusa-slicer-console.exe
SLICER_EXECUTABLE=prusa-slicer
SLICER_TIMEOUT_SECONDS=300
SLICER_MAX_PARALLEL=4
SLICER_MAX_TRIANGLES=2000000
# Hosts the slicer may download signed model URLs from (your Supabase project host)
SLICER_ALLOWED_DOWNLOAD_HOSTS=YOUR_PROJECT_REF.supabase.co
