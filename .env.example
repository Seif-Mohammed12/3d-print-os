# 3D Print OS local environment (no secrets — placeholders only)
NODE_ENV=development
API_PORT=3000
WORKER_PORT=3001
LOG_LEVEL=info

# Required
DATABASE_URL=postgresql://printos:printos@localhost:5432/printos

# Optional — readiness reports redis as "skipped" when unset
REDIS_URL=redis://localhost:6379

# Comma-separated browser origins
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Pool / throttle / boot behavior
DB_POOL_MAX=10
DB_REQUIRED_ON_BOOT=false
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120

# Auth (generate unique secrets for any shared/staging/prod environment)
JWT_ACCESS_SECRET=dev-only-access-secret-change-me-32c
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me-32
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=30

# Supabase (Storage + project URL — service role is server-only)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
UPLOAD_BUCKET=model-files
UPLOAD_MAX_BYTES=52428800
UPLOAD_SIGNED_URL_TTL_SECONDS=600

# Geometry service (slicer-accurate quotes); include the /api/v1 prefix
GEOMETRY_SERVICE_URL=http://localhost:8000/api/v1
SLICE_TIMEOUT_MS=600000
# Shared secret for the geometry service (must equal its SERVICE_API_KEY); 16+ characters
GEOMETRY_SERVICE_KEY=
